{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🦀 Cargo Build",
            /*"icon": {
                "id": "code-review",
                "color": "terminal.ansiRed"
            },*/
            "type": "shell",
            "options": { 
                "cwd": "${workspaceFolder}"
                /*"statusbar": {
                    "label" : "ts"
                }*/
            },
            "command": "cargo build",
            "group": "build"
        },
        {
            "label": "🧠 Cargo SQLx Prepare",
            /*"icon": {
                "id": "database",
                "color": "terminal.ansiYellow"
            },*/
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}"},
            "command": "cargo sqlx prepare",
            "group": "build"
        },
        {
            "label": "🐳 Docker Stack Deploy",
            "type": "shell",
            "options": { "cwd": "${workspaceFolder}/devop"},
            "command": "./deploy-local.sh",
            "group": "build"
        }
        /*{
            "label": "🐳 Docker Compose Up",
